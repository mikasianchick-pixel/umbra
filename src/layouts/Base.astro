---
import { Font } from "astro:assets";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import Toaster from "@/components/Toaster.astro";
import CommandPalette from "@/islands/CommandPalette";
import { games } from "@/data/games";
import { mainNav } from "@/data/nav";
import "@/styles/tokens.css";
import "@/styles/reset.css";
import "@/styles/base.css";
import "@/styles/utilities.css";
import "@/styles/ui.css";
import "@/styles/palette.css";

interface Props {
  title: string;
  description?: string;
  /** главная: загрузчик 0→100% (раз за сессию) и вступительная анимация hero */
  intro?: boolean;
  /** картинка-превью для соцсетей (путь от корня сайта) */
  image?: string;
  /** закрыть страницу от поисковиков (404) */
  noindex?: boolean;
}

const {
  title,
  description = "Umbra — a fictional neon game platform. A portfolio project showing design, 3D, animation and front-end skills.",
  intro = false,
  image = "/og.png",
  noindex = false,
} = Astro.props;
const fullTitle = title === "Umbra" ? title : `${title} · Umbra`;
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL(image, Astro.site);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <!-- порядок слоёв задаётся первым упоминанием; сборщик может склеить CSS компонентов раньше tokens.css -->
    <style is:inline>
      @layer reset, base, components, utilities;
    </style>
    <!-- классы ставятся до первой отрисовки, чтобы загрузчик и интро не «мигали» -->
    <script is:inline define:vars={{ intro }}>
      const root = document.documentElement;
      root.classList.add("js");
      // пасхалки командной палитры (/neon, /retro, /calm) — до первой отрисовки, чтобы не мигало
      try {
        JSON.parse(localStorage.getItem("umbra-fx") || "[]").forEach((fx) =>
          root.classList.add("fx-" + fx),
        );
      } catch {
        /* хранилище недоступно — без пасхалок */
      }
      if (intro) {
        root.classList.add("intro-pending");
        let seen = false;
        try {
          seen = sessionStorage.getItem("umbra-loaded") === "1";
        } catch {
          /* приватный режим — просто показываем загрузчик */
        }
        if (!seen) root.classList.add("is-loading");
      }
    </script>
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="dark" />
    <meta name="theme-color" content="#090910" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="sitemap" href="/sitemap.xml" />

    <!-- превью ссылки в соцсетях и мессенджерах -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Umbra" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Umbra — Play the night away. A fictional neon game launcher." />
    <meta name="twitter:card" content="summary_large_image" />
    <Font cssVariable="--font-orbitron" preload />
    <Font cssVariable="--font-inter" preload />
    <Font cssVariable="--font-jetbrains" />
  </head>
  <body>
    <a class="skip-link" href="#main">
      Skip to content
    </a>
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />
    <Toaster />
    <!-- палитре нужны только названия: передаём лёгкий список, а не все данные игр -->
    <CommandPalette
      client:idle
      games={games.map((g) => ({
        slug: g.slug,
        name: g.name,
        genre: g.tags[0] ?? "",
        price: g.price === 0 ? "Free" : `$${g.price.toFixed(2)}`,
      }))}
      pages={[{ label: "Home", href: "/" }, ...mainNav]}
    />
    <script>
      import "@/scripts/smooth-scroll";
      import { initWishlistButtons } from "@/scripts/wishlist";
      initWishlistButtons();
    </script>
  </body>
</html>

<style>
  .skip-link {
    position: fixed;
    top: var(--space-3);
    left: var(--space-3);
    z-index: var(--z-overlay);
    padding: var(--space-3) var(--space-4);
    border-radius: var(--radius-md);
    background: var(--accent);
    color: var(--bg);
    font-weight: 600;
    translate: 0 -200%;
    transition: translate var(--dur) var(--ease-out);
  }

  .skip-link:focus-visible {
    translate: 0 0;
  }

  main {
    padding-top: calc(var(--header-h) + var(--header-top) * 2);
  }
</style>
