---
// Круглая кнопка-иконка. Стили — src/styles/ui.css.
import type { HTMLAttributes } from "astro/types";
import Icon, { type IconName } from "./Icon.astro";

type Props = {
  icon: IconName;
  /** подпись для скринридера и подсказка при наведении — обязательна, текста у кнопки нет */
  label: string;
  /** кнопка-переключатель (избранное, звук): состояние в aria-pressed */
  toggle?: boolean;
  pressed?: boolean;
  /** «на обложке» — полупрозрачный тёмный фон */
  overlay?: boolean;
  size?: "md" | "sm";
  class?: string;
} & Omit<HTMLAttributes<"button">, "class">;

const {
  icon,
  label,
  toggle = false,
  pressed = false,
  overlay = false,
  size = "md",
  class: className,
  ...rest
} = Astro.props;
---

<button
  class:list={["icon-btn", `icon-btn--${size}`, { "icon-btn--overlay": overlay }, className]}
  type="button"
  aria-label={label}
  title={label}
  aria-pressed={toggle ? pressed : undefined}
  data-icon-toggle={toggle ? "" : undefined}
  {...rest}
>
  <Icon name={icon} size={size === "sm" ? 18 : 20} />
</button>

<script>
  // один обработчик на всю страницу; кнопки избранного (data-wish) ведёт scripts/wishlist.ts
  document.addEventListener("click", (e) => {
    const btn = (e.target as Element).closest<HTMLButtonElement>("[data-icon-toggle]:not([data-wish])");
    if (!btn) return;
    btn.setAttribute("aria-pressed", String(btn.getAttribute("aria-pressed") !== "true"));
  });
</script>
