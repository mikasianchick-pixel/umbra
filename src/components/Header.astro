---
import Button from "./Button.astro";
import Icon from "./Icon.astro";
import { mainNav } from "@/data/nav";

const path = Astro.url.pathname.replace(/\/$/, "") || "/";
const isActive = (href: string) =>
  !href.includes("#") && (path === href || path.startsWith(href + "/"));
---

<header class="header">
  <div class="header__bar container">
    <a class="header__logo" href="/" aria-label="Umbra — home">
      UMBRA
    </a>

    <nav class="header__nav" aria-label="Main">
      <ul role="list">
        {mainNav.map((l) => (
          <li>
            <a href={l.href} aria-current={isActive(l.href) ? "page" : undefined}>
              {l.label}
            </a>
          </li>
        ))}
      </ul>
    </nav>

    <div class="header__actions">
      <a class="header__search" href="/games">
        <Icon name="search" size={18} />
        <span class="header__search-text">Search games…</span>
        <kbd>Ctrl K</kbd>
      </a>
      <Button class="header__pass" href="/#pass" size="sm" icon="bolt">
        Get pass
      </Button>
      <button
        class="header__burger"
        type="button"
        aria-expanded="false"
        aria-controls="mobile-menu"
        aria-label="Open menu"
      >
        <Icon name="menu" size={20} class="header__burger-open" />
        <Icon name="x" size={20} class="header__burger-close" />
      </button>
    </div>
  </div>

  <div class="mobile-menu" id="mobile-menu" hidden>
    <nav class="container" aria-label="Mobile">
      <ol role="list">
        {mainNav.map((l, i) => (
          <li style={`--i:${i}`}>
            <a href={l.href} aria-current={isActive(l.href) ? "page" : undefined}>
              <span class="mobile-menu__num">0{i + 1}</span>
              {l.label}
            </a>
          </li>
        ))}
      </ol>
      <Button href="/#pass" icon="bolt" block>
        Get pass
      </Button>
    </nav>
  </div>
</header>

<script>
  const burger = document.querySelector<HTMLButtonElement>(".header__burger");
  const menu = document.getElementById("mobile-menu");

  if (burger && menu) {
    const setOpen = (open: boolean) => {
      burger.setAttribute("aria-expanded", String(open));
      burger.setAttribute("aria-label", open ? "Close menu" : "Open menu");
      menu.hidden = !open;
      document.documentElement.classList.toggle("menu-open", open);
    };

    burger.addEventListener("click", () => setOpen(menu.hidden !== false));
    menu.addEventListener("click", (e) => {
      if ((e.target as HTMLElement).closest("a")) setOpen(false);
    });
    document.addEventListener("keydown", (e) => {
      if (e.key === "Escape" && !menu.hidden) {
        setOpen(false);
        burger.focus();
      }
    });
    // при переходе на широкий экран меню не должно остаться открытым
    matchMedia("(min-width: 64rem)").addEventListener("change", (e) => e.matches && setOpen(false));
  }
</script>

<style>
  @layer components {
    .header {
      position: fixed;
      inset: var(--header-top) 0 auto;
      z-index: var(--z-header);
    }

    .header__bar {
      display: flex;
      align-items: center;
      gap: var(--space-8);
      height: var(--header-h);
      padding-inline: var(--space-5) var(--space-3);
      border-radius: var(--radius-lg);
      background: var(--glass);
      box-shadow: inset 0 0 0 1px var(--border);
      backdrop-filter: blur(16px) saturate(140%);
    }

    .header__logo {
      font-family: var(--font-display);
      font-weight: 900;
      font-size: var(--text-xl);
      letter-spacing: 0.1em;
      text-shadow: 0 0 16px oklch(0.74 0.14 292 / 0.5);
      border-radius: var(--radius-sm);
    }

    .header__nav {
      display: none;
    }

    .header__nav ul {
      display: flex;
      gap: var(--space-8);
    }

    .header__nav a {
      position: relative;
      display: block;
      padding-block: var(--space-2);
      font-size: var(--text-sm);
      color: var(--text-muted);
      transition: color var(--dur-fast);
    }

    .header__nav a:hover,
    .header__nav a[aria-current="page"] {
      color: var(--text);
    }

    /* точка под активной ссылкой */
    .header__nav a[aria-current="page"]::after {
      content: "";
      position: absolute;
      left: 50%;
      bottom: -6px;
      width: 6px;
      height: 6px;
      translate: -50% 0;
      border-radius: 50%;
      background: var(--accent-2);
      box-shadow: 0 0 8px var(--accent-2);
    }

    .header__actions {
      display: flex;
      align-items: center;
      gap: var(--space-2);
      margin-left: auto;
    }

    .header__search {
      display: grid;
      place-items: center;
      width: 40px;
      height: 40px;
      border-radius: var(--radius-pill);
      background: var(--bg);
      color: var(--text-muted);
      box-shadow: inset 0 0 0 1px var(--border);
      transition:
        color var(--dur-fast),
        box-shadow var(--dur-fast);
    }

    .header__search:hover {
      color: var(--text);
      box-shadow: inset 0 0 0 1px var(--border-strong);
    }

    .header__search-text,
    .header__search kbd,
    .header__pass {
      display: none;
    }

    .header__search kbd {
      padding: 2px var(--space-2);
      border-radius: var(--radius-sm);
      background: var(--surface-3);
      font-size: var(--text-2xs);
    }

    .header__burger {
      display: grid;
      place-items: center;
      width: 40px;
      height: 40px;
      border-radius: var(--radius-pill);
      background: var(--bg);
      box-shadow: inset 0 0 0 1px var(--border);
    }

    .header__burger[aria-expanded="true"] {
      background: var(--accent);
      color: var(--bg);
    }

    .header__burger :global(.header__burger-close),
    .header__burger[aria-expanded="true"] :global(.header__burger-open) {
      display: none;
    }

    .header__burger[aria-expanded="true"] :global(.header__burger-close) {
      display: block;
    }

    /* ---------- мобильное меню ---------- */
    .mobile-menu {
      position: fixed;
      inset: 0;
      z-index: -1;
      padding-top: calc(var(--header-h) + var(--header-top) * 2 + var(--space-8));
      padding-bottom: var(--space-6);
      background:
        radial-gradient(60% 50% at 20% 90%, oklch(0.74 0.14 292 / 0.22), transparent 70%),
        oklch(0.145 0.014 285 / 0.96);
      backdrop-filter: blur(12px);
    }

    .mobile-menu nav {
      display: flex;
      flex-direction: column;
      height: 100%;
    }

    .mobile-menu ol {
      flex: 1;
      display: grid;
      align-content: start;
      gap: var(--space-6);
    }

    .mobile-menu a:not(.btn) {
      display: flex;
      align-items: baseline;
      gap: var(--space-4);
      font-family: var(--font-display);
      font-weight: 900;
      font-size: var(--text-3xl);
      text-transform: uppercase;
      color: var(--text-muted);
    }

    .mobile-menu a[aria-current="page"] {
      color: var(--text);
      text-shadow: var(--glow-text);
    }

    .mobile-menu__num {
      font-family: var(--font-mono);
      font-size: var(--text-xs);
      font-weight: 400;
      color: var(--accent-2);
    }

    @media (prefers-reduced-motion: no-preference) {
      .mobile-menu:not([hidden]) li {
        animation: menu-in var(--dur-slow) var(--ease-out) both;
        animation-delay: calc(var(--i) * 60ms);
      }
    }

    @keyframes menu-in {
      from {
        opacity: 0;
        translate: -24px 0;
      }
    }

    :global(html.menu-open) {
      overflow: hidden;
    }

    @media (min-width: 64rem) {
      .header__nav {
        display: block;
      }

      .header__burger,
      .mobile-menu {
        display: none;
      }

      .header__search {
        display: flex;
        gap: var(--space-3);
        width: auto;
        height: 40px;
        padding-inline: var(--space-3) var(--space-2);
        border-radius: var(--radius-md);
        font-size: var(--text-sm);
      }

      .header__search-text,
      .header__search kbd {
        display: inline;
      }

      .header__search-text {
        min-width: 10rem;
      }

      .header__pass {
        display: inline-flex;
        margin-left: var(--space-2);
      }
    }
  }
</style>
