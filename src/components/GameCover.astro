---
// Процедурная обложка: градиент + размытый шар света + линия горизонта + название.
// Ни одной картинки — у каждой выдуманной игры свой вид из двух цветов.
// Стили — в src/styles/ui.css (их же использует React-каталог).
import type { Game } from "@/data/games";

interface Props {
  game: Game;
  class?: string;
  /** имя для View Transitions: обложка «перелетает» на страницу игры */
  morph?: boolean;
}

const { game, class: className, morph = true } = Astro.props;
const vt = morph ? `; view-transition-name: cover-${game.slug}` : "";
---

<div
  class:list={["cover", className]}
  style={`--cover-a: ${game.cover.a}; --cover-b: ${game.cover.b}${vt}`}
  aria-hidden="true"
>
  <span class="cover__orb"></span>
  <span class="cover__title">{game.coverTitle}</span>
</div>
