---
import type { HTMLAttributes } from "astro/types";
import Icon, { type IconName } from "./Icon.astro";

type Props = {
  id: string;
  label: string;
  /** спрятать подпись визуально (для поиска с иконкой), скринридер её всё равно прочитает */
  hideLabel?: boolean;
  icon?: IconName;
  /** подсказка клавиш справа, например «Ctrl K» */
  kbd?: string;
  error?: string;
} & Omit<HTMLAttributes<"input">, "id">;

const { id, label, hideLabel = false, icon, kbd, error, type = "text", ...rest } = Astro.props;
const errorId = `${id}-error`;
---

<div class:list={["field", { "field--error": error }]}>
  <label for={id} class:list={["field__label", { "visually-hidden": hideLabel }]}>{label}</label>
  <div class="field__box">
    {icon && <Icon name={icon} size={20} class="field__icon" />}
    <input
      id={id}
      class="field__input"
      type={type}
      aria-invalid={error ? "true" : undefined}
      aria-describedby={error ? errorId : undefined}
      {...rest}
    />
    {kbd && <kbd class="field__kbd">{kbd}</kbd>}
  </div>
  {error && <p id={errorId} class="field__error">{error}</p>}
</div>

<style>
  @layer components {
    .field {
      display: grid;
      gap: var(--space-2);
    }

    .field__label {
      font-family: var(--font-mono);
      font-size: var(--text-xs);
      letter-spacing: var(--tracking-mono);
      text-transform: uppercase;
      color: var(--text-muted);
    }

    .field__box {
      display: flex;
      align-items: center;
      gap: var(--space-3);
      height: 52px;
      padding-inline: var(--space-4);
      border-radius: var(--radius-md);
      background: var(--surface-1);
      box-shadow: inset 0 0 0 1px var(--border);
      color: var(--text-muted);
      transition:
        box-shadow var(--dur) var(--ease-out),
        color var(--dur-fast);
    }

    .field__box:hover {
      box-shadow: inset 0 0 0 1px var(--border-strong);
    }

    /* рамка светится, когда фокус внутри — у самого input обводку убираем */
    .field__box:has(:focus-visible) {
      color: var(--accent-2);
      box-shadow:
        inset 0 0 0 1px var(--accent-2),
        0 0 16px oklch(0.83 0.1 205 / 0.25);
    }

    .field__input {
      flex: 1;
      min-width: 0;
      height: 100%;
      border: 0;
      background: none;
      color: var(--text);
      caret-color: var(--accent-2);
    }

    .field__input::placeholder {
      color: var(--text-muted);
      opacity: 1;
    }

    .field__input:focus-visible {
      outline: none;
    }

    /* у type=search свой крестик в Chrome — оставляем, но красим под тему */
    .field__input::-webkit-search-cancel-button {
      filter: invert(0.7);
    }

    .field__kbd {
      padding: 2px var(--space-2);
      border-radius: var(--radius-sm);
      background: var(--surface-3);
      color: var(--text-muted);
      font-size: var(--text-2xs);
    }

    .field--error .field__box {
      box-shadow: inset 0 0 0 1px var(--danger);
    }

    .field__error {
      font-size: var(--text-sm);
      color: var(--danger);
    }
  }
</style>
