---
// Тумблер (switch) и чекбокс — оба на настоящем <input type="checkbox">,
// поэтому работают без JS: Tab — фокус, Пробел — переключить. Стили — src/styles/ui.css.
import type { HTMLAttributes } from "astro/types";
import Icon from "./Icon.astro";

type Props = {
  kind?: "switch" | "checkbox";
} & HTMLAttributes<"input">;

const { kind = "switch", ...rest } = Astro.props;
---

<label class:list={["toggle", `toggle--${kind}`]}>
  <input
    class="toggle__input"
    type="checkbox"
    role={kind === "switch" ? "switch" : undefined}
    {...rest}
  />
  <span class="toggle__ui" aria-hidden="true">
    {kind === "checkbox" && <Icon name="check" size={16} />}
  </span>
  <span class="toggle__text"><slot /></span>
</label>
