---
// Моно-тег жанра. С href — ссылка, с selected — выбранный фильтр. Стили — src/styles/ui.css.
interface Props {
  href?: string;
  selected?: boolean;
  size?: "md" | "sm";
}

const { href, selected = false, size = "md" } = Astro.props;
const Tag = href ? "a" : "span";
---

<Tag
  class:list={["tag", `tag--${size}`, { "tag--selected": selected }]}
  href={href}
  aria-current={href && selected ? "true" : undefined}
>
  <slot />
</Tag>
