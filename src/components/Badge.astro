---
// Бейдж на обложке: новинка, скидка (розовый — редкий цвет), ранний доступ. Стили — src/styles/ui.css.
import type { BadgeKind } from "@/data/games";

interface Props {
  kind: BadgeKind;
  class?: string;
}

const { kind, class: className } = Astro.props;
---

<span class:list={["badge", `badge--${kind}`, className]}><slot /></span>
