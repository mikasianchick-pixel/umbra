---
// Бейдж на обложке: новинка, скидка (розовый — редкий цвет), ранний доступ.
import type { BadgeKind } from "@/data/games";

interface Props {
  kind: BadgeKind;
  class?: string;
}

const { kind, class: className } = Astro.props;
---

<span class:list={["badge", `badge--${kind}`, className]}><slot /></span>

<style>
  @layer components {
    .badge {
      display: inline-block;
      padding: var(--space-1) var(--space-2);
      border-radius: var(--radius-sm);
      color: var(--bg);
      font-family: var(--font-mono);
      font-size: var(--text-xs);
      font-weight: 700;
      line-height: 1.2;
      letter-spacing: 0.04em;
      text-transform: uppercase;
    }

    .badge--new {
      background: var(--accent-2);
    }

    .badge--sale {
      background: var(--hot);
    }

    .badge--early {
      background: var(--surface-2);
      color: var(--accent);
      box-shadow: inset 0 0 0 1px var(--accent);
    }
  }
</style>
