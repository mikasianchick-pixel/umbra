---
import Icon from "./Icon.astro";

interface Props {
  value: number;
  /** количество отзывов, например «2.1k» */
  count?: string;
  /** в плашке (как в разделе бейджей) или просто строкой (в карточке) */
  pill?: boolean;
}

const { value, count, pill = false } = Astro.props;
---

<span class:list={["rating", { "rating--pill": pill }]}>
  <Icon name="star" size={14} filled />
  <span class="visually-hidden">Rated</span>
  <b>{value.toFixed(1)}</b>
  <span class="visually-hidden">out of 5</span>
  {count && <span class="rating__count">({count})</span>}
</span>

<style>
  @layer components {
    .rating {
      display: inline-flex;
      align-items: center;
      gap: 0.375rem;
      font-family: var(--font-mono);
      font-size: var(--text-sm);
      line-height: 1.2;
    }

    .rating :global(svg) {
      color: var(--accent-2);
    }

    .rating--pill {
      padding: 0.375rem var(--space-3);
      border-radius: var(--radius-pill);
      background: var(--surface-1);
      box-shadow: inset 0 0 0 1px var(--line);
    }

    .rating__count {
      color: var(--text-muted);
    }
  }
</style>
