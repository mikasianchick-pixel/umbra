---
// Рейтинг со звездой. Стили — src/styles/ui.css.
import Icon from "./Icon.astro";

interface Props {
  value: number;
  /** количество отзывов, например «2.1k» */
  count?: string;
  /** в плашке (как в разделе бейджей) или просто строкой (в карточке) */
  pill?: boolean;
}

const { value, count, pill = false } = Astro.props;
---

<span class:list={["rating", { "rating--pill": pill }]}>
  <Icon name="star" size={14} filled />
  <span class="visually-hidden">Rated</span>
  <b>{value.toFixed(1)}</b>
  <span class="visually-hidden">out of 5</span>
  {count && <span class="rating__count">({count})</span>}
</span>
