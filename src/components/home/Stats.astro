---
// Цифры платформы. В HTML — готовые значения (видны без JS и поисковикам),
// скрипт home.ts при появлении на экране считает их от нуля.
const stats = [
  { value: "2 400+", count: 2400, suffix: "+", label: "Indie games" },
  { value: "128K", count: 128, suffix: "K", label: "Players online", glow: true },
  { value: "4.9", count: 4.9, suffix: "", label: "Average rating" },
  { value: "99.9%", count: 99.9, suffix: "%", label: "Uptime" },
];
---

<section class="container" aria-label="Umbra in numbers">
  <dl class="stats" data-reveal>
    {
      stats.map((s) => (
        <div class="stat">
          <dt>{s.label}</dt>
          <dd class:list={{ "stat--glow": s.glow }} data-count={s.count} data-suffix={s.suffix}>
            {s.value}
          </dd>
        </div>
      ))
    }
  </dl>
</section>

<style>
  .stats {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--space-8) var(--space-6);
    padding: var(--space-8) var(--space-6);
    border-radius: var(--radius-xl);
    background: var(--surface-1);
    box-shadow: inset 0 0 0 1px var(--border);
  }

  .stat {
    display: flex;
    flex-direction: column-reverse;
    gap: var(--space-2);
  }

  .stat dt {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    letter-spacing: var(--tracking-mono);
    text-transform: uppercase;
    color: var(--text-muted);
  }

  .stat dd {
    font-family: var(--font-display);
    font-size: var(--text-4xl);
    font-weight: 900;
    line-height: 1;
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }

  .stat--glow {
    color: var(--accent-2);
    text-shadow: 0 0 24px oklch(0.83 0.1 205 / 0.5);
  }

  @media (min-width: 64rem) {
    .stats {
      grid-template-columns: repeat(4, 1fr);
      padding: var(--space-10) var(--space-12);
    }

    .stat + .stat {
      padding-left: var(--space-8);
      border-left: 1px solid var(--line);
    }
  }
</style>
