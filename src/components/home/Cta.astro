---
import Button from "@/components/Button.astro";
---

<section class="container" aria-labelledby="cta-title">
  <div class="cta" data-reveal>
    <h2 id="cta-title" class="cta__title">The night is young</h2>
    <p class="cta__text">Join 128 000 players. First month of Pass is on us.</p>
    <Button href="/#pass" variant="hot" icon="play" data-magnetic>Play free now</Button>
  </div>
</section>

<style>
  .cta {
    position: relative;
    isolation: isolate;
    display: grid;
    justify-items: center;
    gap: var(--space-5);
    padding: var(--space-16) var(--space-6);
    overflow: hidden;
    border-radius: var(--radius-xl);
    text-align: center;
    background: linear-gradient(
      90deg,
      color-mix(in oklch, var(--accent) 22%, var(--surface-1)),
      var(--surface-1) 50%,
      color-mix(in oklch, var(--accent-2) 18%, var(--surface-1))
    );
    box-shadow: inset 0 0 0 1px var(--border-strong);
  }

  /* розовое свечение снизу — единственное «горячее» пятно экрана */
  .cta::before {
    content: "";
    position: absolute;
    left: 50%;
    bottom: -40%;
    z-index: -1;
    width: 28rem;
    aspect-ratio: 4 / 3;
    translate: -50% 0;
    border-radius: 50%;
    background: oklch(0.74 0.14 352 / 0.3);
    filter: blur(80px);
  }

  @media (prefers-reduced-motion: no-preference) {
    .cta::before {
      animation: breathe 6s var(--ease-in-out) infinite;
    }
  }

  @keyframes breathe {
    50% {
      scale: 1.2;
      opacity: 0.7;
    }
  }

  .cta__title {
    font-size: var(--text-5xl);
    text-shadow: var(--glow-text);
  }

  .cta__text {
    margin-bottom: var(--space-4);
    font-size: var(--text-lg);
    color: var(--text-muted);
  }

  @media (min-width: 64rem) {
    .cta {
      padding-block: var(--space-24);
    }

    .cta__title {
      font-size: var(--text-display);
    }
  }
</style>
