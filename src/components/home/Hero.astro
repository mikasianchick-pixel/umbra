---
import Button from "@/components/Button.astro";
import Icon from "@/components/Icon.astro";
import OnlineCounter from "@/components/OnlineCounter.astro";
import { link } from "@/data/link";

const stats = [
  { value: "2 400+", count: 2400, suffix: "+", label: "Games" },
  { value: "128K", count: 128, suffix: "K", label: "Online" },
  { value: "4.9", count: 4.9, suffix: "", label: "Avg rating" },
];
---

<section class="hero" aria-labelledby="hero-title" data-hero>
  <div class="hero__floor" aria-hidden="true"></div>

  <div class="hero__scene" data-hero-scene>
    <!-- запасной кристалл: виден, пока грузится 3D, и если WebGL недоступен -->
    <svg class="hero__fallback" viewBox="0 0 400 520" aria-hidden="true">
      <defs>
        <linearGradient id="cr-a" x1="0" y1="0" x2="1" y2="1">
          <stop offset="0" style="stop-color: color-mix(in oklch, var(--accent), white 55%)"></stop>
          <stop offset="1" style="stop-color: var(--accent)"></stop>
        </linearGradient>
        <linearGradient id="cr-b" x1="1" y1="0" x2="0" y2="1">
          <stop offset="0" style="stop-color: color-mix(in oklch, var(--accent-2), white 55%)"></stop>
          <stop offset="1" style="stop-color: var(--accent-2)"></stop>
        </linearGradient>
        <linearGradient id="cr-c" x1="0" y1="0" x2="0" y2="1">
          <stop offset="0" style="stop-color: color-mix(in oklch, var(--accent), black 30%)"></stop>
          <stop offset="1" style="stop-color: var(--surface-2)"></stop>
        </linearGradient>
        <linearGradient id="cr-d" x1="0" y1="0" x2="0" y2="1">
          <stop offset="0" style="stop-color: var(--hot)"></stop>
          <stop offset="1" style="stop-color: color-mix(in oklch, var(--hot), black 70%)"></stop>
        </linearGradient>
        <linearGradient id="cr-e" x1="0" y1="0" x2="0" y2="1">
          <stop offset="0" style="stop-color: color-mix(in oklch, var(--accent-2), black 35%)"></stop>
          <stop offset="1" style="stop-color: var(--surface-1)"></stop>
        </linearGradient>
      </defs>
      <g stroke="white" stroke-opacity="0.35" stroke-width="1.2" stroke-linejoin="round">
        <path d="M200 20 60 200 140 230 200 250z" fill="url(#cr-a)"></path>
        <path d="M200 20 340 200 260 230 200 250z" fill="url(#cr-b)"></path>
        <path d="M60 200 140 230 200 500z" fill="url(#cr-c)"></path>
        <path d="M140 230 200 250 200 500z" fill="url(#cr-c)"></path>
        <path d="M200 250 260 230 200 500z" fill="url(#cr-d)"></path>
        <path d="M260 230 340 200 200 500z" fill="url(#cr-e)"></path>
      </g>
    </svg>
  </div>

  <div class="hero__inner container">
    <div data-intro="fade">
      <OnlineCounter label="players online now" />
    </div>

    <h1 class="hero__title" id="hero-title">
      <span class="hero__line">
        <span data-intro="line">
          Play
          <span class="hero__pill" aria-hidden="true"><Icon name="pad" size={56} /></span>
          the
        </span>
      </span>
      <span class="hero__line">
        <span data-intro="line">
          Night <span class="hero__away glitch" data-text="Away">Away</span>
        </span>
      </span>
    </h1>

    <p class="hero__lead" data-intro="fade">
      Handpicked indie worlds in one launcher. Cloud saves, co-op and achievements — built for long
      nights.
    </p>

    <div class="hero__actions" data-intro="fade">
      <Button href={link("/#pass")} icon="bolt" data-magnetic>Get started</Button>
      <Button href={link("/games")} variant="ghost" icon="arrow">Browse games</Button>
    </div>

    <dl class="hero__stats" data-intro="fade">
      {
        stats.map((s) => (
          <div>
            <dt>{s.label}</dt>
            <dd data-count={s.count} data-suffix={s.suffix}>
              {s.value}
            </dd>
          </div>
        ))
      }
    </dl>
  </div>
</section>

<style>
  .hero {
    position: relative;
    isolation: isolate;
    display: grid;
    padding-block: var(--space-4) var(--space-16);
    /* фон: фиолетовое и бирюзовое свечение за кристаллом */
    background:
      radial-gradient(40rem 40rem at 75% 15%, oklch(0.74 0.14 292 / 0.2), transparent 65%),
      radial-gradient(25rem 25rem at 85% 70%, oklch(0.83 0.1 205 / 0.12), transparent 70%);
  }

  /* ---------- неоновый пол: сетка в перспективе, бесконечно едет на зрителя ---------- */
  .hero__floor {
    position: absolute;
    inset: auto 0 0;
    z-index: -1;
    height: 45%;
    perspective: 320px;
    mask-image: linear-gradient(to bottom, transparent, black 40%);
    overflow: hidden;
  }

  .hero__floor::before {
    content: "";
    position: absolute;
    inset: 0 -50% -20%;
    background-image:
      linear-gradient(oklch(0.74 0.14 292 / 0.28) 1px, transparent 1px),
      linear-gradient(90deg, oklch(0.74 0.14 292 / 0.28) 1px, transparent 1px);
    background-size: var(--space-16) var(--space-16);
    /* нижний край «у ног» зрителя, верхний уходит к горизонту */
    transform: rotateX(62deg);
    transform-origin: bottom;
  }

  @media (prefers-reduced-motion: no-preference) {
    .hero__floor::before {
      animation: floor 2.4s linear infinite;
    }
  }

  @keyframes floor {
    to {
      background-position: 0 var(--space-16);
    }
  }

  /* ---------- 3D ---------- */
  .hero__scene {
    position: relative;
    justify-self: center;
    width: min(100%, 22rem);
    aspect-ratio: 1;
    margin-bottom: calc(var(--space-8) * -1);
  }

  .hero__scene :global(canvas) {
    position: absolute;
    inset: 0;
    width: 100% !important;
    height: 100% !important;
    opacity: 0;
    transition: opacity var(--dur-slow) var(--ease-out);
  }

  .hero__fallback {
    position: absolute;
    inset: 12% 28%;
    width: 44%;
    height: auto;
    margin: auto;
    filter: drop-shadow(0 0 40px oklch(0.74 0.14 292 / 0.5));
    transition: opacity var(--dur-slow) var(--ease-out);
  }

  .hero__scene:global(.is-live) :global(canvas) {
    opacity: 1;
  }

  .hero__scene:global(.is-live) .hero__fallback {
    opacity: 0;
  }

  /* ---------- текст ---------- */
  .hero__inner {
    position: relative;
    display: grid;
    gap: var(--space-6);
    justify-items: start;
  }

  .hero__title {
    font-size: var(--text-display);
    line-height: 1.05;
    letter-spacing: 0.02em;
  }

  /* строка обрезана снизу — слова «выезжают» из-под неё */
  .hero__line {
    display: block;
    overflow: clip;
    overflow-clip-margin: 0.15em;
    padding-bottom: 0.05em;
  }

  .hero__line > span {
    display: inline-block;
  }

  /* живая иконка внутри заголовка */
  .hero__pill {
    display: inline-grid;
    place-items: center;
    width: 1.6em;
    height: 0.9em;
    margin-inline: 0.08em;
    vertical-align: 0.02em;
    border-radius: var(--radius-pill);
    background: var(--gradient-accent);
    box-shadow: 0 0 30px oklch(0.74 0.14 292 / 0.5);
    color: var(--bg);
  }

  .hero__pill :global(svg) {
    width: 0.6em;
    height: 0.6em;
  }

  @media (prefers-reduced-motion: no-preference) {
    .hero__pill :global(svg) {
      animation: wiggle 2.8s var(--ease-in-out) infinite;
    }
  }

  @keyframes wiggle {
    0%,
    60%,
    100% {
      rotate: 0deg;
      scale: 1;
    }
    70% {
      rotate: -14deg;
      scale: 1.1;
    }
    80% {
      rotate: 12deg;
    }
    90% {
      rotate: -6deg;
    }
  }

  .hero__away {
    color: var(--accent);
    text-shadow: 0 0 30px oklch(0.74 0.14 292 / 0.55);
  }

  .hero__lead {
    max-width: 34rem;
    font-size: var(--text-xl);
    color: var(--text-muted);
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-4);
    width: 100%;
  }

  .hero__actions > :global(*) {
    flex: 1 1 14rem;
  }

  .hero__stats {
    display: flex;
    gap: var(--space-10);
    margin-top: var(--space-4);
  }

  .hero__stats div {
    display: flex;
    flex-direction: column-reverse;
    gap: var(--space-1);
  }

  .hero__stats dt {
    font-family: var(--font-mono);
    font-size: var(--text-2xs);
    letter-spacing: var(--tracking-mono);
    text-transform: uppercase;
    color: var(--text-muted);
  }

  .hero__stats dd {
    font-family: var(--font-display);
    font-size: var(--text-3xl);
    font-weight: 700;
    font-variant-numeric: tabular-nums;
  }

  @media (min-width: 64rem) {
    .hero {
      min-height: min(100svh, 56rem);
      align-content: center;
      padding-block: var(--space-12) var(--space-24);
    }

    /* холст во весь hero: частицы летают за текстом, кристалл сдвинут вправо внутри 3D */
    .hero__scene {
      position: absolute;
      inset: 0;
      z-index: -1;
      justify-self: stretch;
      width: auto;
      aspect-ratio: auto;
      margin: 0;
    }

    .hero__fallback {
      inset: 10% 12% 14% auto;
      width: 22%;
      max-width: 20rem;
    }

    .hero__actions {
      width: auto;
    }

    .hero__actions > :global(*) {
      flex: none;
    }
  }

  /* ---------- интро: до старта анимации элементы спрятаны ---------- */
  :global(html.intro-pending) [data-intro] {
    opacity: 0;
    /* страховка: если скрипт не запустился, через 4 с всё покажется само */
    animation: intro-failsafe 0s 4s forwards;
  }

  @keyframes intro-failsafe {
    to {
      opacity: 1;
    }
  }
</style>
