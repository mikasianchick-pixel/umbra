---
// Заголовок секции: «01 / STORE» + большой заголовок. Справа — слот для кнопок/переключателя.
interface Props {
  id: string;
  num: string;
  label: string;
  title: string;
}

const { id, num, label, title } = Astro.props;
---

<header class="sec-head" data-reveal>
  <div class="sec-head__text">
    <p class="eyebrow">{num} / {label}</p>
    <h2 id={id}>{title}</h2>
  </div>
  <slot />
</header>

<style>
  @layer components {
    .sec-head {
      display: flex;
      flex-wrap: wrap;
      align-items: flex-end;
      justify-content: space-between;
      gap: var(--space-6);
      margin-bottom: var(--space-10);
    }

    .sec-head__text {
      display: grid;
      gap: var(--space-3);
    }
  }
</style>
