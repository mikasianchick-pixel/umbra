---
// Карточка игры. Стили — в src/styles/ui.css: ту же разметку рисует React-каталог (islands/GameCardView.tsx).
import type { Game } from "@/data/games";
import { formatPrice, badgeLabel } from "@/data/games";
import GameCover from "./GameCover.astro";
import Badge from "./Badge.astro";
import Tag from "./Tag.astro";
import Rating from "./Rating.astro";
import IconButton from "./IconButton.astro";

interface Props {
  game: Game;
  /** уровень заголовка зависит от страницы */
  headingLevel?: 2 | 3;
  /** false — если эта же игра уже есть на странице с «перелетающей» обложкой */
  morph?: boolean;
}

const { game, headingLevel = 3, morph = true } = Astro.props;
const Heading = `h${headingLevel}` as const;
---

<article class="game-card" style={`--card-glow: ${game.cover.b}`} data-tilt>
  <GameCover game={game} morph={morph} />
  <span class="game-card__glare" aria-hidden="true"></span>

  {
    game.badge && (
      <Badge kind={game.badge} class="game-card__badge">
        {badgeLabel(game)}
      </Badge>
    )
  }

  <IconButton
    class="game-card__wish"
    icon="heart"
    label={`${game.name}: add to wishlist`}
    toggle
    overlay
    size="sm"
    data-wish={game.slug}
    data-wish-name={game.name}
  />

  <div class="game-card__body">
    <p class="game-card__studio">{game.studio}</p>
    <Heading class="game-card__name">
      <a href={`/games/${game.slug}`}>{game.name}</a>
    </Heading>
    <ul class="game-card__tags" role="list" aria-label="Genres">
      {game.tags.map((t) => (
        <li>
          <Tag size="sm">{t}</Tag>
        </li>
      ))}
    </ul>
    <div class="game-card__foot">
      <Rating value={game.rating} />
      <p class="game-card__price">
        {
          game.oldPrice && (
            <s>
              <span class="visually-hidden">Was</span> {formatPrice(game.oldPrice)}
            </s>
          )
        }
        <b class:list={{ "is-sale": game.oldPrice }}>
          {game.oldPrice && <span class="visually-hidden">now</span>}
          {formatPrice(game.price)}
        </b>
      </p>
    </div>
  </div>
</article>
