---
import { footerNav } from "@/data/nav";
---

<footer class="footer">
  <div class="footer__inner container">
    <div class="footer__brand">
      <a class="footer__logo" href="/">
        UMBRA
      </a>
      <p class="muted">Indie worlds for long nights.</p>
    </div>

    {footerNav.map((col) => (
      <nav class="footer__col" aria-label={col.title}>
        <p class="eyebrow">{col.title}</p>
        <ul role="list">
          {col.links.map((l) => (
            <li>
              <a href={l.href}>{l.label}</a>
            </li>
          ))}
        </ul>
      </nav>
    ))}
  </div>

  <p class="footer__note container mono">
    © {new Date().getFullYear()} Umbra — a fictional platform. Portfolio project, not a real store.
  </p>
</footer>

<style>
  @layer components {
    .footer {
      margin-top: var(--section-gap);
      padding-block: var(--space-12) var(--space-8);
      border-top: 1px solid var(--line);
    }

    .footer__inner {
      display: grid;
      gap: var(--space-8);
      grid-template-columns: repeat(2, 1fr);
    }

    .footer__brand {
      grid-column: 1 / -1;
      display: grid;
      align-content: start;
      gap: var(--space-2);
    }

    .footer__logo {
      font-family: var(--font-display);
      font-weight: 900;
      font-size: var(--text-2xl);
      letter-spacing: 0.1em;
      width: fit-content;
    }

    .footer__col {
      display: grid;
      gap: var(--space-4);
      align-content: start;
    }

    .footer__col ul {
      display: grid;
      gap: var(--space-2);
    }

    .footer__col a {
      color: var(--text-muted);
      transition: color var(--dur-fast);
    }

    .footer__col a:hover {
      color: var(--text);
    }

    .footer__note {
      margin-top: var(--space-12);
      font-size: var(--text-xs);
      color: var(--text-muted);
    }

    @media (min-width: 48rem) {
      .footer__inner {
        grid-template-columns: 2fr 1fr 1fr;
      }

      .footer__brand {
        grid-column: auto;
      }
    }
  }
</style>
