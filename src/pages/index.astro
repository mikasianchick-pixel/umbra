---
// Временная главная до этапа 5: проверяем шапку, шрифты и токены.
import Base from "@/layouts/Base.astro";
import Button from "@/components/Button.astro";
---

<Base title="Umbra">
  <section class="soon container">
    <p class="eyebrow">Stage 3 · foundation</p>
    <h1 class="soon__title">
      Play the <span class="glow-text">night</span>
    </h1>
    <p class="lead">
      The home page is on its way. Meanwhile, the design system is live — every colour, font and
      glow you will see here.
    </p>
    <div class="soon__actions">
      <Button href="/system" icon="arrow">
        Open design system
      </Button>
    </div>
  </section>
</Base>

<style>
  .soon {
    min-height: 60svh;
    display: grid;
    align-content: center;
    gap: var(--space-6);
  }

  .soon__title {
    font-size: var(--text-display);
  }

  .soon__title span {
    color: var(--accent);
  }
</style>
